# Copy to .env and fill in. Never commit .env.

# --- Inbound webhook (required) ---------------------------------------------
# Shared secret(s) used to verify X-Lead-Signature. Comma-separate to rotate keys.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# ALLOW_UNSIGNED_WEBHOOKS=false

# --- Dashboard and read API ---------------------------------------------------
# Without it, /dashboard and GET /leads only answer requests from localhost.
ADMIN_PASSWORD=change-me-too
# Public base URL, used for links in Slack messages.
# PUBLIC_URL=https://leads.example.com

# --- LLM (any OpenAI-compatible endpoint). Leave LLM_MODEL empty for rules only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT=30
# Set to false if your endpoint does not support response_format=json_object.
# LLM_JSON_MODE=true

# --- Outputs (each is optional) -----------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# OUTPUT_WEBHOOK_URL=https://example.com/hooks/leads
# OUTPUT_WEBHOOK_SECRET=
# HUBSPOT_ACCESS_TOKEN=
# PIPEDRIVE_API_TOKEN=

# --- Paths ---------------------------------------------------------------------------
# ICP_PATH=config/icp.yaml
# DATABASE_PATH=data/decisions.sqlite3
